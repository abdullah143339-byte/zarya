// ==========================================
// NOVAX - Complete Database Schema
// Based on Document 12: Database & Data Architecture
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTHENTICATION & USERS
// ==========================================

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String?   @map("password_hash")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  displayName     String?   @map("display_name")
  avatar          String?
  coverImage      String?   @map("cover_image")
  bio             String?
  location        String?
  website         String?
  phone           String?
  dateOfBirth     DateTime? @map("date_of_birth")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isPhoneVerified Boolean   @default(false) @map("is_phone_verified")
  isPrivate       Boolean   @default(false) @map("is_private")
  isSuspended     Boolean   @default(false) @map("is_suspended")
  role            UserRole  @default(USER)
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime? @map("last_login_at")
  lastActiveAt    DateTime? @map("last_active_at")
  resetPasswordToken  String? @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  profile         Profile?
  sessions        Session[]
  posts           Post[]
  comments        Comment[]
  reactions       Reaction[]
  bookmarks       Bookmark[]
  followers       Follow[]   @relation("following")
  following       Follow[]   @relation("followers")
  sentMessages    Message[]  @relation("sender")
  notifications   Notification[]
  communities     CommunityMember[]
  learningProgress LearningProgress[]
  learningSubjects LearningSubject[]
  learningNotes    LearningNote[]
  learningLectures LearningLecture[]
  learningFiles    LearningFile[]
  learningTasks    LearningTask[]
  learningBookmarks LearningBookmark[]
  studySessions    StudySession[]
  aiConversations  AIConversation[]
  reputation       Reputation?
  achievements     UserAchievement[]
  wallet           Wallet?
  userSettings    UserSettings?
  connectedAccounts ConnectedAccount[]
  twoFactorAuth   TwoFactorAuth?
  apiKeys         ApiKey[]
  notificationsPrefs NotificationPreference?
  learningPaths   EnrolledLearningPath[]
  courseEnrollments CourseEnrollment[]
  marketplaceItems MarketplaceItem[] @relation("MarketplaceSeller")
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orders          Order[] @relation("buyer")
  sellerOrders    OrderItem[] @relation("seller")
  stories         Story[] @relation("story_owner")
  storyViews      StoryView[] @relation("story_viewer")
  blocks          Block[] @relation("blocked_by")
  blockedBy       Block[] @relation("blocked_user")

  @@map("users")
}

enum UserRole {
  USER
  CREATOR
  INSTRUCTOR
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
  DEACTIVATED
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  token        String   @unique
  refreshToken String?  @unique @map("refresh_token")
  deviceId     String?  @map("device_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  deviceType   String?  @map("device_type")
  browser      String?
  os           String?
  country      String?
  city         String?
  isActive     Boolean  @default(true) @map("is_active")
  lastActivity DateTime @default(now()) @map("last_activity")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model TwoFactorAuth {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  secret          String
  backupCodes     String   @map("backup_codes")
  isEnabled       Boolean  @default(false) @map("is_enabled")
  method          TwoFactorMethod @default(TOTP)
  lastUsedAt      DateTime? @map("last_used_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auth")
}

enum TwoFactorMethod {
  TOTP
  SMS
  EMAIL
  HARDWARE_KEY
}

model ConnectedAccount {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  provider        String
  providerId      String   @map("provider_id")
  accessToken     String?  @map("access_token")
  refreshToken    String?  @map("refresh_token")
  expiresAt       DateTime? @map("expires_at")
  profileData     Json?    @map("profile_data")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("connected_accounts")
}

model ApiKey {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  key         String   @unique
  prefix      String
  permissions Json?
  rateLimit   Int      @default(1000) @map("rate_limit")
  isActive    Boolean  @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

// ==========================================
// USER PROFILES & REPUTATION
// ==========================================

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  headline        String?
  about           String?
  skills          String   @default("[]")
  interests       String   @default("[]")
  languages       String   @default("[]")
  education       Json?
  experience      Json?
  resumeUrl       String?  @map("resume_url")
  portfolioUrl    String?  @map("portfolio_url")
  linkedinUrl     String?  @map("linkedin_url")
  githubUrl       String?  @map("github_url")
  twitterUrl      String?  @map("twitter_url")
  youtubeUrl      String?  @map("youtube_url")
  followersCount  Int      @default(0) @map("followers_count")
  followingCount  Int      @default(0) @map("following_count")
  postsCount      Int      @default(0) @map("posts_count")
  endorsements    Int      @default(0)
  viewCount       Int      @default(0) @map("view_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects        Project[]
  certificates    Certificate[]

  @@map("profiles")
}

model Project {
  id          String   @id @default(uuid())
  profileId   String   @map("profile_id")
  title       String
  description String?
  url         String?
  imageUrl    String?  @map("image_url")
  technologies String   @default("[]")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  isOngoing   Boolean  @default(false) @map("is_ongoing")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("projects")
}

model Certificate {
  id          String   @id @default(uuid())
  profileId   String   @map("profile_id")
  name        String
  issuer      String
  issueDate   DateTime @map("issue_date")
  expiryDate  DateTime? @map("expiry_date")
  credentialId String? @map("credential_id")
  credentialUrl String? @map("credential_url")
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model Reputation {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  totalScore      Int      @default(0) @map("total_score")
  trustScore      Float    @default(0) @map("trust_score")
  expertiseScore  Float    @default(0) @map("expertise_score")
  activityScore   Float    @default(0) @map("activity_score")
  contributionScore Float @default(0) @map("contribution_score")
  level           Int      @default(1)
  tier            RepTier  @default(BRONZE)
  badges          String   @default("[]")
  lastCalculated  DateTime @default(now()) @map("last_calculated")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reputation")
}

enum RepTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  LEGENDARY
}

// ==========================================
// SOCIAL - POSTS, FEED, INTERACTIONS
// ==========================================

model Post {
  id              String   @id @default(uuid())
  authorId        String   @map("author_id")
  content         String
  title           String?
  type            PostType @default(TEXT)
  visibility      PostVisibility @default(PUBLIC)
  media           Json?
  tags            String   @default("[]")
  mentions        String   @default("[]")
  isPinned        Boolean  @default(false) @map("is_pinned")
  isEdited        Boolean  @default(false) @map("is_edited")
  isAIGenerated   Boolean  @default(false) @map("is_ai_generated")
  commentsCount   Int      @default(0) @map("comments_count")
  reactionsCount  Int      @default(0) @map("reactions_count")
  sharesCount     Int      @default(0) @map("shares_count")
  bookmarksCount  Int      @default(0) @map("bookmarks_count")
  viewCount       Int      @default(0) @map("view_count")
  aiScore         Float?   @map("ai_score")
  trendingScore   Float?   @map("trending_score")
  location        String?
  allowComments   Boolean  @default(true) @map("allow_comments")
  allowRemix      Boolean  @default(true) @map("allow_remix")
  allowDownload   Boolean  @default(true) @map("allow_download")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  author          User     @relation(fields: [authorId], references: [id])
  comments        Comment[]
  bookmarks       Bookmark[]
  shares          Share[]

  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@index([type])
  @@index([trendingScore(sort: Desc)])
  @@map("posts")
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  ARTICLE
  POLL
  CODE
  LINK
  AI_GENERATED
  REPOST
  THREAD
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
  COMMUNITY
}

model Comment {
  id          String   @id @default(uuid())
  postId      String   @map("post_id")
  authorId    String   @map("author_id")
  parentId    String?  @map("parent_id")
  content     String
  isEdited    Boolean  @default(false) @map("is_edited")
  isAIGenerated Boolean @default(false) @map("is_ai_generated")
  reactionsCount Int  @default(0) @map("reactions_count")
  repliesCount Int    @default(0) @map("replies_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author       User     @relation(fields: [authorId], references: [id])
  parent       Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies      Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

model Reaction {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  targetType  ReactionTarget
  targetId    String   @map("target_id")
  type        ReactionType @default(LIKE)
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("reactions")
}

enum ReactionTarget {
  POST
  COMMENT
  MESSAGE
}

enum ReactionType {
  LIKE
  LOVE
  LAUGH
  WOW
  SAD
  ANGRY
  FIRE
  ROCKET
  BRAIN
  HEART
}

model Bookmark {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  postId      String   @map("post_id")
  folder      String   @default("default")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id])
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("bookmarks")
}

model Share {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  postId      String   @map("post_id")
  comment     String?
  platform    String?
  createdAt   DateTime @default(now()) @map("created_at")

  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("shares")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  status      FollowStatus @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at")

  follower    User     @relation("followers", fields: [followerId], references: [id])
  following   User     @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

enum FollowStatus {
  ACTIVE
  PENDING
  BLOCKED
}

// ==========================================
// MESSAGING
// ==========================================

model Conversation {
  id              String   @id @default(uuid())
  type            ConversationType @default(DIRECT)
  name            String?
  description     String?
  avatar          String?
  lastMessageAt   DateTime? @map("last_message_at")
  lastMessage     String?  @map("last_message")
  isArchived      Boolean  @default(false) @map("is_archived")
  isEncrypted     Boolean  @default(true) @map("is_encrypted")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  participants    ConversationParticipant[]
  messages        Message[]

  @@map("conversations")
}

enum ConversationType {
  DIRECT
  GROUP
  AI_CHAT
  COMMUNITY
  CHANNEL
}

model ConversationParticipant {
  id              String   @id @default(uuid())
  conversationId  String   @map("conversation_id")
  userId          String   @map("user_id")
  role            ParticipantRole @default(MEMBER)
  isMuted         Boolean  @default(false) @map("is_muted")
  isPinned        Boolean  @default(false) @map("is_pinned")
  unreadCount     Int      @default(0) @map("unread_count")
  lastReadAt      DateTime? @map("last_read_at")
  joinedAt        DateTime @default(now()) @map("joined_at")
  leftAt          DateTime? @map("left_at")

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

model Message {
  id              String   @id @default(uuid())
  conversationId  String   @map("conversation_id")
  senderId        String   @map("sender_id")
  content         String
  type            MessageType @default(TEXT)
  media           Json?
  replyToId       String?  @map("reply_to_id")
  isEdited        Boolean  @default(false) @map("is_edited")
  isDeleted       Boolean  @default(false) @map("is_deleted")
  isForwarded     Boolean  @default(false) @map("is_forwarded")
  readBy          String   @default("[]")
  deliveredTo     String   @default("[]")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User     @relation("sender", fields: [senderId], references: [id])
  replyTo         Message? @relation("MessageReplies", fields: [replyToId], references: [id])
  replies         Message[] @relation("MessageReplies")

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  VOICE_NOTE
  STICKER
  GIF
  CODE
  AI_RESPONSE
  SYSTEM
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  type        NotificationType
  title       String
  body        String
  data        Json?
  actorId     String?  @map("actor_id")
  isRead      Boolean  @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  FOLLOW_REQUEST
  MENTION
  REPOST
  MESSAGE
  COMMUNITY_INVITE
  COMMUNITY_JOIN
  ACHIEVEMENT
  SYSTEM
  MARKETPLACE
  LEARNING
  AI_INSIGHT
  SECURITY_ALERT
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  email           Boolean  @default(true)
  push            Boolean  @default(true)
  inApp           Boolean  @default(true)
  sms             Boolean  @default(false)
  likes           Boolean  @default(true)
  comments        Boolean  @default(true)
  follows         Boolean  @default(true)
  mentions        Boolean  @default(true)
  messages        Boolean  @default(true)
  communities     Boolean  @default(true)
  marketplace     Boolean  @default(true)
  learning        Boolean  @default(true)
  aiInsights      Boolean  @default(true) @map("ai_insights")
  securityAlerts  Boolean  @default(true) @map("security_alerts")
  quietHoursStart String?  @map("quiet_hours_start")
  quietHoursEnd   String?  @map("quiet_hours_end")
  timezone        String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ==========================================
// COMMUNITIES
// ==========================================

model Community {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String?
  shortDescription String? @map("short_description")
  avatar          String?
  coverImage      String?  @map("cover_image")
  ownerId         String?  @map("owner_id")
  type            CommunityType @default(PUBLIC)
  category        String?
  tags            String   @default("[]")
  rules           Json?
  membersCount    Int      @default(0) @map("members_count")
  postsCount      Int      @default(0) @map("posts_count")
  isVerified      Boolean  @default(false) @map("is_verified")
  isFeatured      Boolean  @default(false) @map("is_featured")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  members         CommunityMember[]
  channels        CommunityChannel[]

  @@index([slug])
  @@index([category])
  @@map("communities")
}

enum CommunityType {
  PUBLIC
  PRIVATE
  HIDDEN
}

model CommunityMember {
  id              String   @id @default(uuid())
  communityId     String   @map("community_id")
  userId          String   @map("user_id")
  role            CommunityRole @default(MEMBER)
  status          CommunityMemberStatus @default(ACTIVE)
  joinedAt        DateTime @default(now()) @map("joined_at")
  contributionScore Int   @default(0) @map("contribution_score")

  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id])

  @@unique([communityId, userId])
  @@map("community_members")
}

enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum CommunityMemberStatus {
  ACTIVE
  PENDING
  BANNED
  MUTED
}

model CommunityChannel {
  id              String   @id @default(uuid())
  communityId     String   @map("community_id")
  name            String
  description     String?
  type            ChannelType @default(TEXT)
  isPrivate       Boolean  @default(false) @map("is_private")
  messagesCount   Int      @default(0) @map("messages_count")
  createdAt       DateTime @default(now()) @map("created_at")

  community       Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@map("community_channels")
}

enum ChannelType {
  TEXT
  VOICE
  VIDEO
  ANNOUNCEMENT
}

// ==========================================
// MARKETPLACE
// ==========================================

model MarketplaceItem {
  id              String   @id @default(uuid())
  sellerId        String   @map("seller_id")
  title           String
  description     String
  shortDescription String? @map("short_description")
  type            MarketplaceType
  category        String
  tags            String   @default("[]")
  price           Float
  currency        String   @default("PKR")
  contact         String?  @map("contact")
  isFree          Boolean  @default(false) @map("is_free")
  images          Json?
  files           Json?
  demoUrl         String?  @map("demo_url")
  rating          Float    @default(0)
  reviewCount     Int      @default(0) @map("review_count")
  salesCount      Int      @default(0) @map("sales_count")
  viewCount       Int      @default(0) @map("view_count")
  isFeatured      Boolean  @default(false) @map("is_featured")
  status          ItemStatus @default(ACTIVE)
  stock           Int      @default(-1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  seller          User     @relation("MarketplaceSeller", fields: [sellerId], references: [id])
  reviews         Review[]
  purchases       Purchase[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]

  @@index([sellerId])
  @@index([type, category])
  @@index([rating(sort: Desc)])
  @@map("marketplace_items")
}

enum MarketplaceType {
  TEMPLATE
  COMPONENT
  PLUGIN
  COURSE
  EBOOK
  CODE_SNIPPET
  AI_MODEL
  SERVICE
  HARDWARE
  DIGITAL_ART
}

enum ItemStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD_OUT
  REMOVED
}

model Review {
  id          String   @id @default(uuid())
  itemId      String   @map("item_id")
  buyerId     String   @map("buyer_id")
  rating      Int
  title       String?
  content     String?
  isVerified  Boolean  @default(false) @map("is_verified")
  helpful     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  item        MarketplaceItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, buyerId])
  @@map("reviews")
}

model Purchase {
  id          String   @id @default(uuid())
  itemId      String   @map("item_id")
  buyerId     String   @map("buyer_id")
  amount      Float
  currency    String   @default("USD")
  status      PurchaseStatus @default(COMPLETED)
  paymentMethod String? @map("payment_method")
  createdAt   DateTime @default(now()) @map("created_at")

  item        MarketplaceItem @relation(fields: [itemId], references: [id])

  @@map("purchases")
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

// ==========================================
// LEARNING
// ==========================================

model LearningPath {
  id              String   @id @default(uuid())
  creatorId       String   @map("creator_id")
  title           String
  description     String
  shortDescription String? @map("short_description")
  thumbnail       String?
  category        String
  difficulty      Difficulty @default(BEGINNER)
  tags            String   @default("[]")
  duration        Int?
  price           Float    @default(0)
  isFree          Boolean  @default(true) @map("is_free")
  enrolledCount   Int      @default(0) @map("enrolled_count")
  rating          Float    @default(0)
  reviewCount     Int      @default(0) @map("review_count")
  isPublished     Boolean  @default(false) @map("is_published")
  isFeatured      Boolean  @default(false) @map("is_featured")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  courses         Course[]
  enrollments     EnrolledLearningPath[]

  @@index([category])
  @@index([difficulty])
  @@map("learning_paths")
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model Course {
  id              String   @id @default(uuid())
  learningPathId  String?  @map("learning_path_id")
  instructorId    String   @map("instructor_id")
  title           String
  description     String
  shortDescription String? @map("short_description")
  thumbnail       String?
  category        String
  difficulty      Difficulty @default(BEGINNER)
  tags            String   @default("[]")
  duration        Int?
  price           Float    @default(0)
  isFree          Boolean  @default(true) @map("is_free")
  enrolledCount   Int      @default(0) @map("enrolled_count")
  rating          Float    @default(0)
  reviewCount     Int      @default(0) @map("review_count")
  isPublished     Boolean  @default(false) @map("is_published")
  order           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  learningPath    LearningPath? @relation(fields: [learningPathId], references: [id])
  modules         CourseModule[]
  enrollments     CourseEnrollment[]

  @@index([instructorId])
  @@map("courses")
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId     String   @map("course_id")
  title       String
  description String?
  order       Int      @default(0)
  duration    Int?
  createdAt   DateTime @default(now()) @map("created_at")

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id          String   @id @default(uuid())
  moduleId    String   @map("module_id")
  title       String
  content     String?
  type        LessonType @default(VIDEO)
  mediaUrl    String?  @map("media_url")
  duration    Int?
  order       Int      @default(0)
  isFree      Boolean  @default(false) @map("is_free")
  createdAt   DateTime @default(now()) @map("created_at")

  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("lessons")
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
  INTERACTIVE
  CODE_PLAYGROUND
}

model CourseEnrollment {
  id          String   @id @default(uuid())
  courseId     String   @map("course_id")
  userId      String   @map("user_id")
  progress    Float    @default(0)
  completedAt DateTime? @map("completed_at")
  enrolledAt  DateTime @default(now()) @map("enrolled_at")
  lastAccessed DateTime? @map("last_accessed")

  course      Course   @relation(fields: [courseId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([courseId, userId])
  @@map("course_enrollments")
}

model EnrolledLearningPath {
  id              String   @id @default(uuid())
  learningPathId  String   @map("learning_path_id")
  userId          String   @map("user_id")
  progress        Float    @default(0)
  completedAt     DateTime? @map("completed_at")
  enrolledAt      DateTime @default(now()) @map("enrolled_at")

  learningPath    LearningPath @relation(fields: [learningPathId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@unique([learningPathId, userId])
  @@map("enrolled_learning_paths")
}

model LearningProgress {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  courseId     String?  @map("course_id")
  lessonId    String?  @map("lesson_id")
  status      ProgressStatus @default(NOT_STARTED)
  progress    Float    @default(0)
  score       Int?
  timeSpent   Int      @default(0) @map("time_spent")
  startedAt   DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("learning_progress")
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ==========================================
// LEARNING HUB (User Personal Workspace)
// ==========================================

model LearningSubject {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  emoji       String   @default("📚")
  color       String   @default("violet")
  description String   @default("")
  archived    Boolean  @default(false)
  trashed     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes       LearningNote[]
  lectures    LearningLecture[]
  files       LearningFile[]
  tasks       LearningTask[]

  @@index([userId])
  @@map("learning_subjects")
}

model LearningNote {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  subjectId String?  @map("subject_id")
  title     String   @default("Untitled")
  content   String   @default("")
  tags      String   @default("[]")
  pinned    Boolean  @default(false)
  favorite  Boolean  @default(false)
  archived  Boolean  @default(false)
  trashed   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   LearningSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("learning_notes")
}

model LearningLecture {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  subjectId   String?  @map("subject_id")
  title       String
  description String   @default("")
  teacher     String   @default("")
  tags        String   @default("[]")
  source      String   @default("youtube")
  url         String   @default("")
  mediaUrl    String   @default("") @map("media_url")
  durationMin Int?     @map("duration_min")
  completed   Boolean  @default(false)
  favorite    Boolean  @default(false)
  archived    Boolean  @default(false)
  trashed     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   LearningSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("learning_lectures")
}

model LearningFile {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  subjectId String?  @map("subject_id")
  name      String
  kind      String
  size      Int      @default(0)
  mime      String   @default("")
  dataUrl   String   @default("") @map("data_url")
  tags      String   @default("[]")
  favorite  Boolean  @default(false)
  archived  Boolean  @default(false)
  trashed   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   LearningSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("learning_files")
}

model LearningTask {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  subjectId  String?   @map("subject_id")
  title      String
  notes      String    @default("")
  deadline   DateTime? @map("deadline")
  reminderAt DateTime? @map("reminder_at")
  priority   String    @default("medium")
  completed  Boolean   @default(false)
  archived   Boolean   @default(false)
  trashed    Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    LearningSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("learning_tasks")
}

model LearningBookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  refType   String   @map("ref_type")
  refId     String   @map("ref_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refType, refId])
  @@map("learning_bookmarks")
}

model StudySession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      String
  minutes   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("study_sessions")
}

// ==========================================
// AI SYSTEM
// ==========================================

model AIConversation {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String?
  model       String
  context     Json?
  isActive    Boolean  @default(true) @map("is_active")
  messageCount Int     @default(0) @map("message_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id])
  messages    AIMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AIMessage {
  id              String   @id @default(uuid())
  conversationId  String   @map("conversation_id")
  role            AIRole
  content         String
  model           String?
  tokensUsed      Int?     @map("tokens_used")
  responseTime    Int?     @map("response_time")
  rating          Int?
  feedback        String?
  context         Json?
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  conversation    AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum AIRole {
  USER
  ASSISTANT
  SYSTEM
}

// ==========================================
// GAMIFICATION & WALLET
// ==========================================

model Achievement {
  id          String   @id @default(uuid())
  name        String   @unique
  title       String
  description String
  icon        String
  category    AchievementCategory
  tier        AchievementTier @default(BRONZE)
  points      Int      @default(0)
  requirement Json?
  isHidden    Boolean  @default(false) @map("is_hidden")
  createdAt   DateTime @default(now()) @map("created_at")

  users       UserAchievement[]

  @@map("achievements")
}

enum AchievementCategory {
  ENGAGEMENT
  CREATION
  LEARNING
  COMMUNITY
  MARKETPLACE
  AI_USAGE
  STREAK
  MILESTONE
}

enum AchievementTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model UserAchievement {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  achievementId   String   @map("achievement_id")
  unlockedAt      DateTime @default(now()) @map("unlocked_at")
  progress        Int      @default(100)

  user            User     @relation(fields: [userId], references: [id])
  achievement     Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Wallet {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  balance         Float    @default(0)
  currency        String   @default("USD")
  totalEarned     Float    @default(0) @map("total_earned")
  totalSpent      Float    @default(0) @map("total_spent")
  totalWithdrawn  Float    @default(0) @map("total_withdrawn")
  isVerified      Boolean  @default(false) @map("is_verified")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id])
  transactions    Transaction[]

  @@map("wallets")
}

model Transaction {
  id          String   @id @default(uuid())
  walletId    String   @map("wallet_id")
  type        TransactionType
  amount      Float
  currency    String   @default("USD")
  description String?
  referenceId String?  @map("reference_id")
  referenceType String? @map("reference_type")
  status      TransactionStatus @default(COMPLETED)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  wallet      Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt(sort: Desc)])
  @@map("transactions")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PURCHASE
  SALE
  REWARD
  REFUND
  TRANSFER
  SUBSCRIPTION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

// ==========================================
// SEARCH & ANALYTICS
// ==========================================

model SearchHistory {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  query       String
  type        SearchType
  results     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([query])
  @@map("search_history")
}

enum SearchType {
  USER
  POST
  COMMUNITY
  COURSE
  MARKETPLACE
  GLOBAL
}

// ==========================================
// SECURITY & AUDIT
// ==========================================

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  action      String
  resource    String
  resourceId  String?  @map("resource_id")
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model SecurityEvent {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  type        SecurityEventType
  severity    Severity @default(LOW)
  description String
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  metadata    Json?
  isResolved  Boolean  @default(false) @map("is_resolved")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([type])
  @@index([severity])
  @@map("security_events")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  PASSWORD_CHANGE
  EMAIL_CHANGE
  TWO_FA_ENABLED
  TWO_FA_DISABLED
  SUSPICIOUS_ACTIVITY
  ACCOUNT_LOCKED
  TOKEN_REFRESH
  SESSION_REVOKED
  API_KEY_USED
  DATA_EXPORT
  ACCOUNT_DELETION
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String   @map("reporter_id")
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  reviewedBy  String?  @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  resolution  String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("reports")
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  VIOLENCE
  MISINFORMATION
  COPYRIGHT
  SELF_HARM
  NUDITY
  SCAM
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model UserSettings {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  theme           String   @default("dark")
  language        String   @default("en")
  timezone        String?
  isDiscoverable  Boolean  @default(true) @map("is_discoverable")
  showOnlineStatus Boolean @default(true) @map("show_online_status")
  showReadReceipts Boolean @default(true) @map("show_read_receipts")
  allowDirectMessages Boolean @default(true) @map("allow_direct_messages")
  contentFilter   String   @default("medium") @map("content_filter")
  aiPersonalization Boolean @default(true) @map("ai_personalization")
  dataSharing     Boolean  @default(false) @map("data_sharing")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ==========================================
// MARKETPLACE ADDITIONS (CART, WISHLIST, ORDERS)
// ==========================================

model CartItem {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  itemId          String   @map("item_id")
  quantity        Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  item            MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@map("cart_items")
}

model WishlistItem {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  itemId          String   @map("item_id")
  createdAt       DateTime @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  item            MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@map("wishlist_items")
}

model Order {
  id              String   @id @default(uuid())
  buyerId         String   @map("buyer_id")
  status          OrderStatus @default(PENDING)
  totalAmount     Float    @map("total_amount")
  currency        String   @default("USD")
  paymentMethod   String?  @map("payment_method")
  paymentIntentId String?  @map("payment_intent_id")
  shippingAddress Json?    @map("shipping_address")
  billingAddress  Json?    @map("billing_address")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  buyer           User     @relation("buyer", fields: [buyerId], references: [id])
  items           OrderItem[]

  @@index([buyerId])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  itemId          String   @map("item_id")
  sellerId        String   @map("seller_id")
  quantity        Int
  priceAtPurchase Float    @map("price_at_purchase")
  currency        String   @default("USD")
  status          OrderItemStatus @default(PENDING)
  createdAt       DateTime @default(now()) @map("created_at")

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item            MarketplaceItem @relation(fields: [itemId], references: [id])
  seller          User            @relation("seller", fields: [sellerId], references: [id])

  @@index([orderId])
  @@index([sellerId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderItemStatus {
  PENDING
  FULFILLED
  CANCELLED
  REFUNDED
}

// ==========================================
// STORIES
// ==========================================

model Story {
  id         String     @id @default(uuid())
  ownerId    String     @map("owner_id")
  media      String
  mediaType  StoryMediaType @default(IMAGE) @map("media_type")
  caption    String?
  expiresAt  DateTime   @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  deletedAt  DateTime?  @map("deleted_at")

  owner      User       @relation("story_owner", fields: [ownerId], references: [id], onDelete: Cascade)
  views      StoryView[]

  @@index([ownerId, expiresAt])
  @@index([expiresAt])
  @@map("stories")
}

enum StoryMediaType {
  IMAGE
  VIDEO
  TEXT
}

model StoryView {
  id         String   @id @default(uuid())
  storyId    String   @map("story_id")
  viewerId   String   @map("viewer_id")
  viewedAt   DateTime @default(now()) @map("viewed_at")

  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer     User     @relation("story_viewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([storyId])
  @@map("story_views")
}

// ==========================================
// BLOCKS (user blocking)
// ==========================================

model Block {
  id         String   @id @default(uuid())
  blockerId  String   @map("blocker_id")
  blockedId  String   @map("blocked_id")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  blocker    User     @relation("blocked_by", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    User     @relation("blocked_user", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}
